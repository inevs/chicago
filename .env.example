# The API validates its variables at startup and does not start if one is
# missing or invalid (see apps/api/src/app/config/environment.validation.ts).

# Database
DATABASE_URL="postgresql://dividends:dividends@localhost:5432/dividends?schema=public"

# Currency (DEFAULT_CURRENCY: three uppercase letters, e.g. EUR)
DEFAULT_CURRENCY=EUR
DEFAULT_CURRENCY_NAME="Euro"

# Market data (EOD prices, start date in the format YYYY-MM-DD)
SECURITY_PRICE_HISTORY_START=2017-01-01

# Authentication
JWT_SECRET="your-secret-key-change-this-in-production"
# Self-registration via POST /api/auth/register (default: disabled).
# The app runs in single-user mode: every account can access all data.
# Only enable temporarily, e.g. to create an additional account.
ALLOW_REGISTRATION=false

# Admin User (for database seeding)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_TO_STRONG_PASSWORD_MIN_16_CHARS"
ADMIN_NAME="Admin User"

# Sample data (for database seeding, default: disabled).
# When "true", the seed creates sample securities, transactions and dividends,
# but only if the database contains no securities yet and DEFAULT_CURRENCY is EUR.
SEED_SAMPLE_DATA=false
