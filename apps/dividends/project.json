{
  "name": "dividends",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/dividends/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/dividends",
        "browser": "apps/dividends/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/dividends/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/dividends/public"
          }
        ],
        "styles": ["apps/dividends/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "dependsOn": ["api:serve"],
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "apps/dividends/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "dividends:build:production"
        },
        "development": {
          "buildTarget": "dividends:build:development"
        }
      },
      "readyWhen": {
        "signal": true
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "dividends:build"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "outputs": ["{workspaceRoot}/coverage/{projectName}"],
      "options": {
        "runner": "vitest",
        "buildTarget": "dividends:build:development",
        "tsConfig": "apps/dividends/tsconfig.spec.json",
        "isolate": true
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "dividends:build",
        "staticFilePath": "dist/apps/dividends/browser",
        "spa": true
      }
    }
  }
}
