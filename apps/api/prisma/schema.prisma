// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enum for security types
enum SecurityType {
  STOCK
  ETF
  BOND
}

// Enum for transaction types
enum TransactionType {
  BUY
  SELL
}

// Security model - represents stocks, ETFs, and bonds
model Security {
  id        String   @id @default(uuid())
  name      String   // Company/fund name (e.g., "Apple Inc.")
  symbol    String   @unique // Ticker symbol (e.g., "AAPL")
  isin      String?  // International Securities Identification Number
  wkn       String?  // Wertpapierkennnummer (German security identifier)
  type      SecurityType // STOCK, ETF, or BOND
  exchange  String   // Stock exchange (e.g., "NASDAQ", "NYSE", "XETRA")
  currency  String   // Trading currency (ISO 4217 code, e.g., "USD", "EUR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  currencyRef          Currency            @relation("SecurityCurrency", fields: [currency], references: [code])
  dividendPayments      DividendPayment[]
  securityTransactions  SecurityTransaction[]
  securityPrices        SecurityPrice[]

  // Indexes for common queries
  @@index([isin])
  @@index([wkn])
  @@map("securities") // Plural table name convention
}

// DividendPayment model - represents individual dividend payments
model DividendPayment {
  id              String   @id @default(uuid())

  // Dates
  exDate          DateTime // Ex-dividend date
  payoutDate      DateTime // Actual payment/settlement date

  // Security relationship
  securityId      String
  security        Security @relation(fields: [securityId], references: [id], onDelete: Cascade)
  originCurrencyRef Currency @relation("DividendOriginCurrency", fields: [originCurrency], references: [code])
  destCurrencyRef   Currency @relation("DividendDestCurrency", fields: [destCurrency], references: [code])

  // Fundamental amounts (other amounts can be computed)
  shares          Decimal  @db.Decimal(19, 8) // Number of shares held at ex-date
  dividendYield   Decimal  @db.Decimal(19, 4) // Dividend per share
  taxAmount       Decimal  @db.Decimal(19, 4) // Tax withheld

  // Currency conversion
  originCurrency  String   // Currency of original dividend (ISO 4217 code, e.g., "USD")
  destCurrency    String   // Destination/account currency (ISO 4217 code, e.g., "EUR")
  conversionRate  Decimal  @db.Decimal(19, 8) // Exchange rate used for conversion
  finalPayment    Decimal  @db.Decimal(19, 4) // Final payment in destination currency

  // Optional fields
  note            String?  @db.Text // User notes about this payment

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Indexes for common queries
  @@index([securityId])
  @@index([exDate])
  @@index([payoutDate])
  @@index([securityId, exDate]) // Compound index for filtering by security and date
  @@map("dividend_payments") // Plural table name convention
}

// SecurityTransaction model - represents buy/sell transactions for securities
model SecurityTransaction {
  id              String          @id @default(uuid())

  // Transaction metadata
  date            DateTime        // Transaction date
  type            TransactionType // BUY or SELL

  // Security relationship
  securityId      String
  security        Security        @relation(fields: [securityId], references: [id], onDelete: Cascade)
  currencyRef     Currency        @relation("SecurityTransactionCurrency", fields: [currency], references: [code])

  // Transaction details
  quantity        Decimal         @db.Decimal(19, 8) // Number of shares/units
  pricePerShare   Decimal         @db.Decimal(19, 4) // Price per share/unit
  fees            Decimal         @db.Decimal(19, 4) // Fees and commissions

  // Currency conversion
  currency        String          // Transaction currency (ISO 4217 code, e.g., "USD", "EUR")
  exchangeRate    Decimal         @db.Decimal(19, 8) // Exchange rate to base currency (EUR)
  totalValue      Decimal         @db.Decimal(19, 4) // Total value in base currency (EUR)

  // Optional fields
  note            String?         @db.Text // User notes/comments

  // Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Indexes for common queries
  @@index([securityId])
  @@index([date])
  @@index([type])
  @@index([securityId, date]) // Compound index for filtering by security and date
  @@map("security_transactions") // Plural table name convention
}

// SecurityPrice model - represents end-of-day price history
model SecurityPrice {
  id         String   @id @default(uuid())
  securityId String
  security   Security @relation(fields: [securityId], references: [id], onDelete: Cascade)
  date       DateTime // Trading date (EOD)
  open       Decimal  @db.Decimal(19, 6)
  high       Decimal  @db.Decimal(19, 6)
  low        Decimal  @db.Decimal(19, 6)
  close      Decimal  @db.Decimal(19, 6)
  volume     Decimal? @db.Decimal(22, 4)
  currency   String   // Trading currency (ISO 4217 code, e.g., "USD", "EUR")
  provider   String   // Data provider identifier
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([securityId, date])
  @@index([securityId])
  @@index([date])
  @@index([securityId, date])
  @@map("security_prices")
}

// Currency model - represents available currencies for transactions
model Currency {
  id        String   @id @default(uuid())
  code      String   @unique // ISO 4217 code (EUR, USD, etc.)
  name      String   // Display name (Euro, US Dollar, etc.)
  createdAt DateTime @default(now())

  securities             Security[]           @relation("SecurityCurrency")
  dividendPaymentsOrigin DividendPayment[]    @relation("DividendOriginCurrency")
  dividendPaymentsDest   DividendPayment[]    @relation("DividendDestCurrency")
  securityTransactions   SecurityTransaction[] @relation("SecurityTransactionCurrency")

  @@map("currencies")
}
