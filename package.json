    "db:migrate:deploy": "prisma migrate deploy --config=apps/api/prisma.config.ts",
    "db:migrate:reset": "prisma migrate reset --config=apps/api/prisma.config.ts",
    "db:migrate:status": "prisma migrate status --config=apps/api/prisma.config.ts",
    "db:studio": "prisma studio --config=apps/api/prisma.config.ts",
    "db:seed": "tsx apps/api/prisma/seed.ts",
    "db:reset": "prisma migrate reset --config=apps/api/prisma.config.ts --skip-seed",
    "db:format": "prisma format --config=apps/api/prisma.config.ts",
    "db:validate": "prisma validate --config=apps/api/prisma.config.ts"
  },
